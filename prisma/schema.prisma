datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Doctor {
  id          String   @id @default(cuid())
  name        String
  title       String
  specialty   String
  bio         String
  qualifications String[]
  experience  String
  image       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Treatment {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String?
  image       String?
  category    String
  price       String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  src       String
  alt       String
  category  String   // "clinic", "before-after", "team"
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  text      String
  source    String   @default("manual") // "google", "manual"
  date      String?
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
